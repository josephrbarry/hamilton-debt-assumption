    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Opinion",
                    "textStyle": {
                      "fontFamily": "Georgia",
                      "fontSize": "15pt",
                      "color": "#1F3A5F",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Method: not defensible. Six of thirteen states filed returns. The two largest were cut by a quarter. Four states with no return got $3.1M by round number.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#22262B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Outcome: defensible. 85% of the quota was used. The states that over-subscribed were the ones Hamilton said owed the most. The 1793 audit confirmed the biggest recipients (MA, SC) were the biggest creditors. Relief tracked contribution.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#22262B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Madison: wrong on his own state. The audit he demanded found Virginia a net debtor, $100,879.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#22262B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Basis of preparation",
                    "textStyle": {
                      "fontFamily": "Georgia",
                      "fontSize": "13pt",
                      "color": "#1F3A5F",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Five primary ledgers, each footed before use (Schedule B). One does not foot: two line errors in the 1792 subscription table ($500,000 and $30,000), reconciled and disclosed.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#7A8290"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1790 specie dollars; 2025 dollars at 36.3x CPI. $21.5M was ~11% of 1790 GDP (a modern reconstruction), about $3.4 trillion in today's economy.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#7A8290"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              }
            ]
          }
        }
